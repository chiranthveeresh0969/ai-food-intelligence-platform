# Application
APP_ENV=development
LOG_LEVEL=INFO

# Food Recognition Provider ("gemini" or "mock")
FOOD_RECOGNIZER_PROVIDER=gemini

# Google Gemini API (get key from https://aistudio.google.com/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Database (SQLite for MVP; swap to PostgreSQL URL later)
DATABASE_URL=sqlite:///./food_intelligence.db